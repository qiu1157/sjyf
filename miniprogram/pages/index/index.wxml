<!--首页--><view class="container">
  <!-- 顶部走马灯海报 -->
  <view class="banner-section">
    <swiper class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{bannerList}}" wx:key="id">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill" />
        <view class="banner-overlay">
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-desc">{{item.desc}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 服务分类 -->
  <view class="category-section">
    <view class="section-header">
      <view class="section-title">服务分类</view>
      <view class="section-more" bindtap="viewMoreCategory">
        更多
        <text class="arrow-right">›</text>
      </view>
    </view>
    <view class="category-grid">
      <view class="category-item" wx:for="{{categoryList}}" wx:key="id" bindtap="selectCategory" data-id="{{item.id}}">
        <view class="category-icon-wrapper" style="background: {{item.bgColor}}">
          <image class="category-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 最新活动专区 -->
  <view class="activity-section">
    <view class="section-header">
      <view class="section-title">
        <text class="hot-icon">🔥</text>
        最新活动
      </view>
      <view class="section-more" bindtap="viewMoreActivity">
        更多
        <text class="arrow-right">›</text>
      </view>
    </view>
    <scroll-view class="activity-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="activity-list">
        <view class="activity-item" wx:for="{{activityList}}" wx:key="id" bindtap="selectActivity" data-id="{{item.id}}">
          <image class="activity-image" src="{{item.image}}" mode="aspectFill" />
          <view class="activity-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
          <view class="activity-content">
            <view class="activity-title">{{item.title}}</view>
            <view class="activity-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
              <text class="price-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            </view>
            <view class="activity-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 热门推荐 -->
  <view class="recommend-section">
    <view class="section-header">
      <view class="section-title">
        <text class="star-icon">⭐</text>
        热门推荐
      </view>
    </view>
    <view class="recommend-list">
      <view class="recommend-item" wx:for="{{recommendList}}" wx:key="id" bindtap="selectRecommend" data-id="{{item.id}}">
        <image class="recommend-image" src="{{item.image}}" mode="aspectFill" />
        <view class="recommend-content">
          <view class="recommend-title">{{item.title}}</view>
          <view class="recommend-tags">
            <text class="tag-item" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
          <view class="recommend-bottom">
            <view class="recommend-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
              <text class="price-unit">/次起</text>
            </view>
            <view class="recommend-sales">已售 {{item.sales}}+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
