/* 首页样式 */

.container {
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 顶部走马灯海报 */
.banner-section {
  position: relative;
  width: 100%;
}

.banner-swiper {
  width: 100%;
  height: 380rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 0 0 24rpx 24rpx;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
  color: #ffffff;
  border-radius: 0 0 24rpx 24rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 通用区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
  display: flex;
  align-items: center;
}

.arrow-right {
  margin-left: 4rpx;
  font-size: 30rpx;
}

.hot-icon,
.star-icon {
  margin-right: 8rpx;
}

/* 服务分类 */
.category-section {
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 0 16rpx 32rpx;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  transition: transform 0.2s;
}

.category-item:active {
  transform: scale(0.95);
}

.category-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.category-icon {
  width: 52rpx;
  height: 52rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  line-height: 1.3;
}

/* 最新活动专区 */
.activity-section {
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.activity-scroll {
  white-space: nowrap;
  padding: 0 24rpx 32rpx;
}

.activity-list {
  display: flex;
  gap: 20rpx;
}

.activity-item {
  display: inline-block;
  width: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: transform 0.2s;
}

.activity-item:active {
  transform: scale(0.98);
}

.activity-image {
  width: 100%;
  height: 180rpx;
}

.activity-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.activity-content {
  padding: 20rpx;
  white-space: normal;
}

.activity-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.activity-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.price-symbol {
  font-size: 22rpx;
  color: #ff6b35;
  font-weight: 600;
}

.price-value {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: 700;
  margin-right: 8rpx;
}

.price-original {
  font-size: 22rpx;
  color: #cccccc;
  text-decoration: line-through;
}

.activity-desc {
  font-size: 22rpx;
  color: #999999;
}

/* 热门推荐 */
.recommend-section {
  margin: 20rpx 24rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-item {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.recommend-item:active {
  transform: scale(0.99);
}

.recommend-image {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.recommend-content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 12rpx 0;
}

.tag-item {
  font-size: 20rpx;
  color: #ff6b35;
  background: #fff5f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.recommend-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.recommend-price {
  display: flex;
  align-items: baseline;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
}

.recommend-sales {
  font-size: 22rpx;
  color: #999999;
}
