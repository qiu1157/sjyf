<!--详情页-->
<view class="container">
  <!-- 服务图片 -->
  <image class="detail-image" src="{{serviceInfo.image}}" mode="aspectFill" />

  <!-- 服务基本信息 -->
  <view class="info-section">
    <view class="service-title">{{serviceInfo.title}}</view>
    <view class="service-tags">
      <text class="tag-item" wx:for="{{serviceInfo.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
    </view>
    <view class="price-row">
      <view class="price-wrapper">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{serviceInfo.price}}</text>
        <text class="price-unit" wx:if="{{serviceInfo.unit}}">{{serviceInfo.unit}}</text>
      </view>
      <view class="sales-info">已售 {{serviceInfo.sales}}+</view>
    </view>
  </view>

  <!-- 服务内容 -->
  <view class="content-section">
    <view class="section-title">服务内容</view>
    <view class="content-list">
      <view class="content-item" wx:for="{{serviceContent}}" wx:key="id">
        <view class="item-icon">✓</view>
        <view class="item-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <!-- 服务保障 -->
  <view class="guarantee-section">
    <view class="section-title">服务保障</view>
    <view class="guarantee-list">
      <view class="guarantee-item" wx:for="{{guarantees}}" wx:key="id">
        <image class="guarantee-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="guarantee-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 服务流程 -->
  <view class="process-section">
    <view class="section-title">服务流程</view>
    <view class="process-list">
      <view class="process-item" wx:for="{{processList}}" wx:key="id">
        <view class="step-number">{{item.step}}</view>
        <view class="step-content">
          <view class="step-title">{{item.title}}</view>
          <view class="step-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户评价 -->
  <view class="review-section">
    <view class="section-header">
      <view class="section-title">用户评价</view>
      <view class="review-count">共 {{reviewList.length}} 条</view>
    </view>
    <view class="review-list">
      <view class="review-item" wx:for="{{reviewList}}" wx:key="id">
        <view class="reviewer-info">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="reviewer-name">{{item.name}}</view>
          <view class="review-rating">
            <text class="star" wx:for="{{5}}" wx:key="*this" wx:for-item="star">{{star < item.rating ? '★' : '☆'}}</text>
          </view>
        </view>
        <view class="review-content">{{item.content}}</view>
        <view class="review-date">{{item.date}}</view>
      </view>
    </view>
  </view>

  <!-- 底部预约栏 -->
  <view class="bottom-bar">
    <view class="contact-btn" bindtap="contactService">
      <image class="contact-icon" src="/images/icons/service.png" mode="aspectFit" />
      <text class="contact-text">客服</text>
    </view>
    <view class="collect-btn" bindtap="collectService">
      <image class="collect-icon" src="{{isCollected ? '/images/icons/star-filled.png' : '/images/icons/star.png'}}" mode="aspectFit" />
      <text class="collect-text">收藏</text>
    </view>
    <button class="book-btn" bindtap="bookService">立即预约</button>
  </view>
</view>
