/* 详情页样式 */
.container {
  background: #f7f8fa;
  padding-bottom: 120rpx;
}

/* 服务图片 */
.detail-image {
  width: 100%;
  height: 450rpx;
}

/* 服务基本信息 */
.info-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.service-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff5f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 600;
}

.price-value {
  font-size: 48rpx;
  color: #ff6b35;
  font-weight: 700;
  margin: 0 8rpx;
}

.price-unit {
  font-size: 24rpx;
  color: #999999;
}

.sales-info {
  font-size: 24rpx;
  color: #999999;
}

/* 通用区块样式 */
.content-section,
.guarantee-section,
.process-section,
.review-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

/* 服务内容 */
.content-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.content-item {
  display: flex;
  align-items: flex-start;
}

.item-icon {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  color: #ffffff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-text {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 服务保障 */
.guarantee-list {
  display: flex;
  justify-content: space-around;
}

.guarantee-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guarantee-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}

.guarantee-text {
  font-size: 24rpx;
  color: #666666;
}

/* 服务流程 */
.process-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.process-item {
  display: flex;
  align-items: flex-start;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

/* 用户评价 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.review-count {
  font-size: 24rpx;
  color: #999999;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.review-item {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.reviewer-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.reviewer-name {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.review-rating {
  color: #ffc107;
  font-size: 24rpx;
}

.review-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.review-date {
  font-size: 22rpx;
  color: #cccccc;
}

/* 底部预约栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.contact-btn,
.collect-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.contact-icon,
.collect-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.contact-text,
.collect-text {
  font-size: 20rpx;
  color: #999999;
}

.book-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8e53);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-btn::after {
  border: none;
}
